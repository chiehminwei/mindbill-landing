# Required for /api/trigger-call (the APA conference event page).
# Set these in Vercel: Project → Settings → Environment Variables.

# Retell API key (https://dashboard.retellai.com/dashboard/apiKey)
RETELL_API_KEY=

# Outbound phone number to call FROM (must be a Retell-managed or imported number).
# E.164 format, e.g. +16506683443
RETELL_FROM_NUMBER=

# Agent ID to use for the outbound call. Find it in the Retell dashboard
# under your agent → "Agent ID". Leave blank to use the default agent
# attached to RETELL_FROM_NUMBER.
RETELL_AGENT_ID=
